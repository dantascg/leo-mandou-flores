---
// ─────────────────────────────────────────────────────────────
// BUQUÊ — contador real (ver src/pages/api/bouquet.ts). Soma quando:
// (a) alguém aperta uma das ações do cartão em "Envie uma Flor", ou
// (b) clica direto aqui (fica pra teste/demonstração).
//
// Por performance, a partir de um certo número de flores o desenho
// para de adicionar mais ícones (fica "cheio" visualmente), mas o
// NÚMERO exibido continua sempre real — ver MAX_FLOWERS_DRAWN no script.
// ─────────────────────────────────────────────────────────────
---

<section id="buque" class="bouquet panel panel--roxo">
  <div class="wrap bouquet__inner">
    <h2 class="bouquet__title reveal">BUQUÊ</h2>
    <p class="eyebrow bouquet__count reveal" data-delay="0.05">
      <span id="bouquet-count">—</span> flores enviadas
    </p>

    <button type="button" id="bouquet-btn" class="bouquet__stage reveal tap-target" data-delay="0.1" aria-label="Enviar uma flor (teste)">
      <!-- Flores aparecem aqui, em leque acima do vaso -->
      <div id="bouquet-flowers" class="bouquet__flowers" aria-hidden="true"></div>

      <!-- Vaso SVG: triângulo invertido rosa -->
      <svg class="bouquet__vase" viewBox="0 0 260 220" aria-hidden="true">
        <polygon points="30,0 230,0 165,200 95,200" fill="var(--rosa)" />
        <!-- borda sutil no vaso -->
        <polygon points="30,0 230,0 165,200 95,200" fill="none" stroke="var(--rosa-soft)" stroke-width="2" />
      </svg>
    </button>

    <p class="eyebrow bouquet__hint" id="bouquet-hint">toque pra enviar a sua (teste)</p>
  </div>
</section>

<script>
  import gsap from "gsap";

  const MAX_FLOWERS_DRAWN = 60;

  const btn = document.getElementById("bouquet-btn");
  const flowersEl = document.getElementById("bouquet-flowers") as HTMLDivElement;
  const countEl = document.getElementById("bouquet-count") as HTMLSpanElement;
  const hint = document.getElementById("bouquet-hint");

  let drawn = 0;

  function flowerSvg() {
    const wrap = document.createElement("div");
    wrap.className = "bouquet__flower";
    wrap.innerHTML = `
      <svg viewBox="0 0 40 40" width="22" height="22" aria-hidden="true">
        <g transform="translate(20,20)">
          <ellipse cx="0" cy="-9" rx="5" ry="9" transform="rotate(0)" />
          <ellipse cx="0" cy="-9" rx="5" ry="9" transform="rotate(72)" />
          <ellipse cx="0" cy="-9" rx="5" ry="9" transform="rotate(144)" />
          <ellipse cx="0" cy="-9" rx="5" ry="9" transform="rotate(216)" />
          <ellipse cx="0" cy="-9" rx="5" ry="9" transform="rotate(288)" />
          <circle r="4" fill="var(--roxo-soft)" />
        </g>
      </svg>
    `;
    return wrap;
  }

  // Posiciona as flores em leque ACIMA do vaso (não dentro).
  // O vaso ocupa a parte inferior do .bouquet__stage.
  // As flores saem da boca do vaso (topo do triângulo) em arco.
  // Posiciona flores em ARCO SEMICIRCULAR acima da boca do vaso.
  // O vaso ocupa a metade inferior: a boca (abertura) está em ~50% do topo do stage.
  // As flores emanam do centro desse ponto em leque de 180°.
  function positionFlower(el: HTMLElement, index: number, total: number) {
    // ângulo em leque: 0° = esquerda, 180° = direita (semicírculo superior)
    // Distribui de forma ligeiramente mais densa no centro
    const t = total <= 1 ? 0.5 : index / (total - 1);
    // angulo de -85° a +85° (evita extremos retos demais)
    const angleDeg = -85 + t * 170;
    const angleRad = (angleDeg * Math.PI) / 180;

    // Raio: varia por "camada" (fileira) para criar profundidade
    // Flores mais próximas do centro do índice ficam numa camada mais interna
    const layer = Math.floor(index / 10); // camadas de 10 em 10
    // raio em % do container: 22% (interno) a 46% (externo)
    const baseRadius = 22 + layer * 8;
    const radiusPct = Math.min(baseRadius + Math.random() * 6, 47);

    // O ponto de origem está no centro horizontal (50%) e em ~52% de altura
    // (ponto que corresponde à boca do vaso)
    const originX = 50;
    const originY = 52; // % de baixo (usando bottom, então 48% do topo)

    // Converte coordenadas polares -> cartesianas relativas ao container
    // x: centro + raio * sen(angulo)
    // y: aumenta para cima (bottom % cresce para cima)
    const x = originX + radiusPct * Math.sin(angleRad);
    const y = originY + radiusPct * Math.abs(Math.cos(angleRad)) * 0.75;

    const jitterX = (Math.random() - 0.5) * 5;
    const jitterY = (Math.random() - 0.5) * 4;
    const jitterR = (Math.random() - 0.5) * 40;

    el.style.setProperty("--x", `${Math.max(5, Math.min(95, x + jitterX))}%`);
    el.style.setProperty("--rise", `${Math.max(48, Math.min(94, y + jitterY))}%`);
    el.style.setProperty("--rot", `${jitterR}deg`);
  }

  function addFlowerVisual(animate = true) {
    if (drawn >= MAX_FLOWERS_DRAWN) {
      // já "cheio" — só pulso visual
      gsap.fromTo(flowersEl, { scale: 1 }, { scale: 1.04, duration: 0.14, yoyo: true, repeat: 1 });
      return;
    }
    const el = flowerSvg();
    flowersEl.appendChild(el);
    positionFlower(el, drawn, MAX_FLOWERS_DRAWN);
    drawn++;

    if (animate) {
      gsap.fromTo(
        el,
        { opacity: 0, scale: 0, y: 16 },
        { opacity: 1, scale: 1, y: 0, duration: 0.45, ease: "back.out(1.8)" }
      );
    } else {
      gsap.set(el, { opacity: 1, scale: 1, y: 0 });
    }
  }

  async function fetchCount() {
    try {
      const res = await fetch("/api/bouquet");
      const data = await res.json();
      const total = Number(data.count) ?? 0;
      // Exibe o número (0 se vier zerado, não "—")
      if (countEl) countEl.textContent = total.toLocaleString("pt-BR");

      // Desenha o buquê "pronto" até o total atual (sem animação de entrada)
      const toDraw = Math.min(total, MAX_FLOWERS_DRAWN);
      for (let i = 0; i < toDraw; i++) addFlowerVisual(false);
    } catch {
      if (countEl) countEl.textContent = "0";
    }
  }

  async function sendFlower() {
    if (hint) gsap.to(hint, { opacity: 0, duration: 0.3 });

    addFlowerVisual(true);

    try {
      const res = await fetch("/api/bouquet", { method: "POST" });
      const data = await res.json();
      const newCount = Number(data.count) || 0;
      if (countEl) {
        countEl.textContent = newCount.toLocaleString("pt-BR");
        gsap.fromTo(
          countEl,
          { scale: 1.3, color: "var(--cream)" },
          { scale: 1, color: "var(--rosa)", duration: 0.5, ease: "power2.out" }
        );
      }
    } catch {
      // segue o baile mesmo se a API falhar — a flor já apareceu na tela
    }
  }

  fetchCount();
  btn?.addEventListener("click", sendFlower);

  // Alguém compartilhou/baixou/copiou um cartão de verdade lá em cima
  window.addEventListener("flor-enviada", sendFlower);
</script>

<style>
  .bouquet {
    padding: 7rem 0 8rem;
    text-align: center;
  }

  .bouquet__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bouquet__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.8rem, 9vw, 5rem);
    letter-spacing: 0.05em;
    color: var(--rosa);
    margin-bottom: 0.6rem;
  }

  .bouquet__count {
    color: rgba(246, 233, 222, 0.5);
    margin-bottom: 3rem;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
  }

  .bouquet__count span {
    color: var(--rosa);
    font-weight: 800;
    font-size: 1.1rem;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    transition: color 0.3s;
  }

  /* Container principal — clicável */
  .bouquet__stage {
    position: relative;
    width: min(88vw, 24rem);
    aspect-ratio: 1 / 1.05;
    display: block;
    cursor: pointer;
  }

  /* Vaso SVG: ocupa a metade inferior do stage */
  .bouquet__vase {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 72%;
    height: 55%;
  }

  /* Flores: ocupam a área inteira (incluindo acima do vaso) */
  .bouquet__flowers {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  :global(.bouquet__flower) {
    position: absolute;
    left: var(--x, 50%);
    bottom: var(--rise, 55%);
    transform: translateX(-50%) rotate(var(--rot, 0deg));
    color: var(--rosa);
    pointer-events: none;
  }

  :global(.bouquet__flower svg ellipse) {
    fill: currentColor;
  }

  :global(.bouquet__flower svg circle) {
    /* miolo já tem fill definido inline */
  }

  .bouquet__hint {
    margin-top: 1.75rem;
    color: rgba(246, 233, 222, 0.3);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
  }

  /* Hover suave no stage */
  .bouquet__stage:hover .bouquet__vase {
    filter: brightness(1.1);
    transition: filter 0.2s ease;
  }
</style>
