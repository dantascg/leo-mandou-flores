---
import { SITE } from "../data/site.js";
---

<section id="top" class="hero panel panel--rosa">
  <!-- Logo única: hero-logo.png (flores + wordmark em um só arquivo) -->
  <div class="hero__center">
    <div id="recipient-banner" class="recipient-banner" hidden><span id="recipient-name"></span>, VOCÊ RECEBEU UMA FLOR 🌸 <a href="#manda-flores">mande uma de volta</a></div>
    <h1 class="hero__logo-wrap">
      <span class="sr-only">Léo Mandou Flores</span>
      <img
        src="/hero-logo.png"
        alt="Léo Mandou Flores — identidade visual do álbum"
        class="hero__logo"
        width="960"
        height="640"
        fetchpriority="high"
        draggable="false"
      />
    </h1>

    <div class="release-countdown" id="release-countdown" aria-label="O álbum sai em 05 de dezembro"><span>05.12</span></div>
    <div class="hero__streams" aria-label="Ouça o álbum">
      {SITE.presave ? <a class="hero__presave tap-target eyebrow" href={SITE.presave} target="_blank" rel="noopener noreferrer">PRÉ-SAVE</a> : null}
      {
        (!SITE.presave ? SITE.streaming : []).map((s) => (
          <a
            href={s.href}
            class="hero__stream tap-target"
            aria-label={`Ouvir no ${s.name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={s.icon} alt="" class="hero__stream-icon" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Seta de scroll: indica deslizar para baixo -->
  <div class="hero__scroll-hint" aria-hidden="true">
    <svg
      class="hero__arrow"
      viewBox="0 0 24 14"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <polyline
        points="2,2 12,12 22,2"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></polyline>
    </svg>
  </div>
</section>

<script define:vars={{ releaseDate: SITE.releaseDate }}>
  const countdown = document.getElementById("release-countdown");
  const updateCountdown = () => {
    if (!countdown) return;
    const remaining = new Date(releaseDate).getTime() - Date.now();
    if (remaining <= 0) { countdown.hidden = true; return; }
    const minutes = Math.floor(remaining / 60000);
    const days = Math.floor(minutes / 1440);
    const hours = Math.floor((minutes % 1440) / 60);
    const mins = minutes % 60;
    countdown.textContent = `SAI EM ${days}D ${hours}H ${mins}M`;
    countdown.setAttribute("aria-label", `O álbum sai em ${days} dias, ${hours} horas e ${mins} minutos`);
  };
  updateCountdown();
  window.setInterval(updateCountdown, 60000);

  const params = new URLSearchParams(window.location.search);
  const raw = params.get("para");
  if (raw) {
    const safe = raw.slice(0, 40).replace(/[\u0000-\u001f\u007f]/g, "").trim();
    if (safe) { const banner = document.getElementById("recipient-banner"); const name = document.getElementById("recipient-name"); if (banner && name) { name.textContent = safe.toLocaleUpperCase("pt-BR"); banner.hidden = false; } }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
    text-align: center;
  }

  .hero__center {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .recipient-banner { max-width: 38rem; font: 700 var(--fs-xs) var(--font-main); letter-spacing: .12em; color: var(--roxo); }
  .recipient-banner a { display: block; margin-top: .45rem; text-decoration: underline; letter-spacing: .06em; }
  .release-countdown { min-height: 1.2rem; color: var(--roxo); font: 700 var(--fs-xs) var(--font-main); letter-spacing: .18em; }
  .hero__presave { padding: .75rem 1.3rem; background: var(--roxo); color: var(--cream); }

  /* Logo única — responsiva e estática */
  .hero__logo-wrap {
    margin: 0;
    line-height: 1;
  }

  .hero__logo {
    width: min(88vw, 42rem);
    height: auto;
    object-fit: contain;
    user-select: none;
    /* Fundo branco da imagem vira transparente via mix-blend-mode */
    mix-blend-mode: multiply;
  }

  .hero__streams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .hero__stream {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--roxo);
    background: rgba(59, 13, 30, 0.12);
    transition:
      background 0.25s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .hero__stream-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  .hero__stream:hover {
    background: rgba(59, 13, 30, 0.2);
    transform: translateY(-2px);
  }

  .hero__stream:hover .hero__stream-icon {
    filter: brightness(0) invert(1);
  }

  /* Seta de scroll — fixa no rodapé do Hero */
  .hero__scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: var(--roxo);
    opacity: 0.45;
  }

  .hero__arrow {
    width: 28px;
    height: 16px;
    display: block;
  }
</style>
