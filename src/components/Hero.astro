---
import { SITE } from "../data/site.js";
---

<section id="top" class="hero panel panel--rosa">
  <!-- Logo única: hero-logo.png (flores + wordmark em um só arquivo) -->
  <div class="hero__center">
    <h1 class="hero__logo-wrap">
      <span class="sr-only">Léo Mandou Flores</span>
      <img
        src="/hero-logo.png"
        alt="Léo Mandou Flores — identidade visual do álbum"
        class="hero__logo"
        width="960"
        height="640"
        fetchpriority="high"
        draggable="false"
      />
    </h1>

    <div class="hero__streams">
      {
        SITE.streaming.map((s) => (
          <a
            href={s.href}
            class="hero__stream tap-target"
            aria-label={s.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={s.icon} alt="" class="hero__stream-icon" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Seta de scroll: indica deslizar para baixo -->
  <div class="hero__scroll-hint" aria-hidden="true">
    <svg
      class="hero__arrow"
      viewBox="0 0 24 14"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <polyline
        points="2,2 12,12 22,2"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></polyline>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 5rem;
    text-align: center;
  }

  .hero__center {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  /* Logo única — responsiva e estática */
  .hero__logo-wrap {
    margin: 0;
    line-height: 1;
  }

  .hero__logo {
    width: min(88vw, 42rem);
    height: auto;
    object-fit: contain;
    user-select: none;
    /* Fundo branco da imagem vira transparente via mix-blend-mode */
    mix-blend-mode: multiply;
  }

  .hero__streams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .hero__stream {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--roxo);
    background: rgba(59, 13, 30, 0.12);
    transition:
      background 0.25s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .hero__stream-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  .hero__stream:hover {
    background: rgba(59, 13, 30, 0.2);
    transform: translateY(-2px);
  }

  .hero__stream:hover .hero__stream-icon {
    filter: brightness(0) invert(1);
  }

  /* Seta de scroll — fixa no rodapé do Hero */
  .hero__scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: var(--roxo);
    opacity: 0.45;
  }

  .hero__arrow {
    width: 28px;
    height: 16px;
    display: block;
  }
</style>
