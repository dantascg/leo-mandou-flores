---
// ─────────────────────────────────────────────────────────────
// NAVBAR
// Links: Álbum, Manda Flores, Buquê (sem Tracklist/Arquivo)
// CTA "Ouvir" removido — a Hero já é a seção de ouvir
// ─────────────────────────────────────────────────────────────
const links = [
  { href: "#top", label: "Álbum" },
  { href: "#manda-flores", label: "Manda Flores" },
  { href: "#buque", label: "Buquê" },
];
---

<nav class="nav">
  <a href="#top" class="nav__brand" aria-label="LÉO MANDOU FLORES — início">
    <img
      src="/generated/logo-96.webp"
      alt="LÉO MANDOU FLORES"
      class="nav__logo"
      width="140"
      height="140"
      loading="eager"
      decoding="async"
    />
  </a>

  <div class="nav__links">
    {
      links.map((l) => (
        <a href={l.href} class="nav__link eyebrow">
          {l.label}
        </a>
      ))
    }
    <button type="button" class="theme-toggle tap-target" id="theme-toggle" aria-label="Ativar modo escuro" aria-pressed="false">
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.5rem;
    background: var(--rosa);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(59, 13, 30, 0.25);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  @media (min-width: 768px) {
    .nav {
      padding: 0.7rem 2.5rem;
    }
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  .nav__logo {
    height: 55px;
    width: auto;
    object-fit: contain;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(.75rem, 2vw, 2rem);
  }

  .nav__link {
    color: var(--roxo);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    opacity: 1;
    white-space: nowrap;
    transition: color 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover { color: var(--roxo); }
  }

  .theme-toggle {
    position: relative;
    color: var(--roxo);
    padding: 0;
    line-height: 0;
  }
  .theme-toggle:focus-visible { outline: 1px solid var(--cream); outline-offset: 4px; }
  .theme-icon { position: absolute; top: 50%; left: 0; width: 18px; height: 18px; display: block; transition: opacity .25s ease, transform .25s var(--ease-out); }
  .theme-icon--moon { opacity: 1; transform: translateY(-50%) rotate(0); }
  .theme-icon--sun { opacity: 0; transform: translateY(-50%) rotate(-35deg) scale(.7); }
  :global(html[data-theme="escuro"]) .nav { background: var(--roxo); border-color: rgba(246,233,222,.22); }
  :global(html[data-theme="escuro"]) .nav__link,
  :global(html[data-theme="escuro"]) .theme-toggle { color: var(--cream); }
  :global(html[data-theme="escuro"]) .theme-icon--moon { opacity: 0; transform: translateY(-50%) rotate(35deg) scale(.7); }
  :global(html[data-theme="escuro"]) .theme-icon--sun { opacity: 1; transform: translateY(-50%) rotate(0) scale(1); }

  /* Navbar some suavemente na seção do Buquê (fundo roxo) */
  .nav--hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
  }

  @media (max-width: 1100px) {
    .nav__links { gap: clamp(.55rem, 1.7vw, 1.1rem); }
    .nav__link { letter-spacing: .04em; }
  }

  @media (max-width: 820px) {
    .nav__links { gap: .5rem; }
    .nav__link { font-size: .68rem; }
  }

  @media (max-width: 560px) {
    .nav__logo { height: 48px; }
    .nav__links { gap: .15rem; }
    .nav__link { font-size: .64rem; letter-spacing: .02em; }
    .theme-toggle { padding: 0; }
  }

  @media (max-width: 480px) {
    .nav__links { gap: 18px; }
    .nav__link,
    .theme-toggle { min-height: 44px; }
    .nav__link { display: inline-flex; align-items: center; font-size: 12px; letter-spacing: .02em; }
    .theme-toggle { margin-left: 0; }
  }

  @media (max-width: 360px) {
    .nav__logo { height: 46px; }
  }
</style>

<script>
  const nav = document.querySelector(".nav") as HTMLElement;
  const buqueSection = document.getElementById("buque");

  if (nav && buqueSection) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle("nav--hidden", entry.isIntersecting);
      },
      {
        // Activa quando pelo menos 15% da seção está visível
        threshold: 0.15,
      },
    );
    observer.observe(buqueSection);
  }
</script>

<script>
  const themeToggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;
  const themeMeta = document.getElementById("theme-color") as HTMLMetaElement | null;
  function updateThemeButton() {
    const dark = document.documentElement.dataset.theme === "escuro";
    themeToggle?.setAttribute("aria-label", dark ? "Ativar modo claro" : "Ativar modo escuro");
    themeToggle?.setAttribute("aria-pressed", String(dark));
    if (themeMeta) themeMeta.content = dark ? "#3b0d1e" : "#ca0053";
  }
  updateThemeButton();
  themeToggle?.addEventListener("click", () => {
    const dark = document.documentElement.dataset.theme !== "escuro";
    const apply = () => {
      document.documentElement.dataset.theme = dark ? "escuro" : "padrao";
      try { localStorage.setItem("leo-theme", dark ? "escuro" : "padrao"); } catch {}
      updateThemeButton();
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("startViewTransition" in document)) {
      apply();
    } else {
      (document as Document & { startViewTransition?: (callback: () => void) => unknown }).startViewTransition?.(apply);
    }
  });
</script>
