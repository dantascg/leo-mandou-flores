---
import { FLOWERS } from "../data/flowers.js";
---

<section id="manda-flores" class="manda panel panel--rosa">
  <div class="wrap">
    <!-- Título via imagem exportada do CorelDRAW -->
    <h2 class="manda__title reveal">
      <img
        src="/envie-uma-flor.png"
        alt="Envie uma Flor"
        class="manda__title-img"
        draggable="false"
      />
    </h2>

    <div class="manda__grid">
      <div class="manda__config reveal" data-delay="0.1">
        <div class="manda__field">
          <p class="eyebrow manda__label">Para quem é?</p>
          <input
            id="manda-name"
            type="text"
            class="manda__input"
            maxlength="40"
            placeholder="Nome de quem vai receber"
          />
        </div>

        <div class="manda__field">
          <p class="eyebrow manda__label">Escolha a flor</p>
          <div class="manda__flowers" role="radiogroup" aria-label="Escolha uma flor">
            {FLOWERS.map((f, i) => (
              <button
                type="button"
                class="flower-btn"
                data-flower={f.id}
                data-flower-name={f.name}
                aria-pressed={i === 0 ? "true" : "false"}
                aria-label={f.name}
              >
                <!-- Se você adicionar a imagem da flor em public/flowers/<id>.png, ela carrega aqui -->
                {f.icon && (
                  <img
                    src={f.icon}
                    alt=""
                    class="flower-btn__img"
                    onerror="this.style.display='none'"
                  />
                )}
                <span class="flower-btn__name">{f.name}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="manda__field">
          <p class="eyebrow manda__label">Escreva sua mensagem</p>
          <div class="manda__textarea-wrap">
            <textarea
              id="manda-message"
              class="manda__textarea"
              maxlength="120"
              rows="4"
              placeholder="Uma frase, um trecho de letra, o que quiser..."></textarea>
            <span class="manda__count" id="manda-count">0/120</span>
          </div>
        </div>

        <div class="manda__actions">
          <button type="button" id="manda-share" class="manda__btn manda__btn--solid eyebrow tap-target" disabled>
            Compartilhar
          </button>
          <button type="button" id="manda-download" class="manda__btn manda__btn--outline eyebrow tap-target" disabled>
            Baixar
          </button>
          <button
            type="button"
            id="manda-clipboard"
            class="manda__btn manda__btn--outline manda__btn--icon eyebrow tap-target"
            aria-label="Copiar imagem"
            title="Copiar imagem"
            disabled
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <rect x="8" y="3" width="11" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <rect x="4" y="8" width="11" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </button>
        </div>
        <p class="manda__feedback eyebrow" id="manda-feedback" aria-live="polite"></p>
        <div id="turnstile-container" aria-hidden="true"></div>
      </div>

      <div class="manda__preview reveal" data-delay="0.2">
        <p class="eyebrow manda__label">Prévia</p>

        <!-- Card: rosa do projeto + borda roxa arredondada -->
        <div class="card" id="manda-card">
          <p class="card__to">para: <span id="card-name">alguém</span></p>

          <div class="card__quote-box">
            <p class="card__quote" id="card-message">"Escreva sua mensagem ao lado..."</p>
          </div>

          <div class="card__footer">
            <!-- PNG rasterizado do qr-site.svg para compatibilidade com html2canvas no Safari. -->
            <div class="card__qr-wrap">
              <img id="card-qr" class="card__qr" src="/qr-site.png" alt="QR code para leomandouflores.com" width="56" height="56" />
            </div>
            <div class="card__flower-badge" id="card-flower-badge">
              <img
                id="card-flower-icon"
                class="card__flower-icon"
                src="/flowers/lirio.png"
                alt=""
              />
              <span id="card-flower-name" class="card__flower-name">Lírio</span>
            </div>
            <img src="/logo.png" alt="LÉO MANDOU FLORES" class="card__logo" width="150" height="150" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const FLOWER_NAMES: Record<string, string> = {
    lirio: "Lírio",
    papoula: "Papoula",
    tulipa: "Tulipa",
    rosa: "Rosa",
  };

  let selectedFlower = "lirio";
  const FLOWER_IDS = new Set(["lirio", "papoula", "tulipa", "rosa"]);

  const flowerBtns = document.querySelectorAll<HTMLButtonElement>(".flower-btn");
  const nameInput = document.getElementById("manda-name") as HTMLInputElement;
  const textarea = document.getElementById("manda-message") as HTMLTextAreaElement;
  const count = document.getElementById("manda-count") as HTMLSpanElement;
  const shareBtn = document.getElementById("manda-share") as HTMLButtonElement;
  const downloadBtn = document.getElementById("manda-download") as HTMLButtonElement;
  const clipboardBtn = document.getElementById("manda-clipboard") as HTMLButtonElement;
  const feedback = document.getElementById("manda-feedback") as HTMLParagraphElement;
  const cardName = document.getElementById("card-name") as HTMLSpanElement;
  const cardMessage = document.getElementById("card-message") as HTMLParagraphElement;
  const cardElement = document.getElementById("manda-card") as HTMLElement;
  const qrImg = document.getElementById("card-qr") as HTMLImageElement;
  const cardFlowerIcon = document.getElementById("card-flower-icon") as HTMLImageElement;
  const cardFlowerName = document.getElementById("card-flower-name") as HTMLSpanElement;

  function updateButtons() {
    const hasText = textarea.value.trim().length > 0;
    shareBtn.disabled = !hasText;
    downloadBtn.disabled = !hasText;
    clipboardBtn.disabled = !hasText;
  }

  flowerBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      flowerBtns.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      const requestedFlowerId = btn.dataset.flower || "";
      const flowerId = FLOWER_IDS.has(requestedFlowerId) ? requestedFlowerId : "lirio";
      selectedFlower = flowerId;
      if (cardFlowerIcon) {
        cardFlowerIcon.src = `/flowers/${flowerId}.png`;
      }
      if (cardFlowerName) {
        cardFlowerName.textContent = FLOWER_NAMES[flowerId] || btn.dataset.flowerName || "";
      }
    });
  });

  nameInput?.addEventListener("input", () => {
    cardName.textContent = nameInput.value.trim() || "alguém";
  });

  textarea?.addEventListener("input", () => {
    const value = textarea.value;
    count.textContent = `${value.length}/120`;
    cardMessage.textContent = value ? `"${value}"` : '"Escreva sua mensagem ao lado..."';
    cardMessage.classList.toggle("card__quote--empty", !value);
    updateButtons();
  });

  const EXPORT_WIDTH = 1080;        // largura final do PNG, em pixels
  const MAX_PIXELS = 16_000_000;    // trava de segurança para celulares fracos
  const MAX_SCALE = 4;

  async function waitForImages(root: HTMLElement) {
    const imgs = Array.from(root.querySelectorAll("img"));
    await Promise.all(imgs.map((img) => {
      if (!img.complete) {
        return new Promise<void>((resolve) => {
          const done = () => resolve();
          img.addEventListener("load", done, { once: true });
          img.addEventListener("error", done, { once: true });
        });
      }
      return Promise.resolve();
    }));

    await Promise.all(imgs.map(async (img) => {
      if (typeof img.decode === "function") {
        try {
          await img.decode();
        } catch {
          // O html2canvas ainda pode lidar com imagens que o decode rejeita.
        }
      }
    }));
  }

  async function renderCardToBlob(): Promise<Blob | null> {
    const html2canvas = (await import("html2canvas")).default;
    if (document.fonts?.ready) await document.fonts.ready;
    await waitForImages(cardElement);

    const w = cardElement.offsetWidth;
    const h = cardElement.offsetHeight;
    const wanted = EXPORT_WIDTH / w;
    const safe = Math.sqrt(MAX_PIXELS / (w * h));
    const scale = Math.max(1, Math.min(wanted, safe, MAX_SCALE));

    const canvas = await html2canvas(cardElement, {
      scale,
      backgroundColor: "#CA0053",
      useCORS: true,
      logging: false,
      onclone: (clonedDocument) => {
        const clonedCard = clonedDocument.getElementById("manda-card");
        if (clonedCard instanceof HTMLElement) {
          // O preview mantém borda/cantos; só a cópia exportada vira um retângulo cheio.
          clonedCard.style.borderColor = "transparent";
          clonedCard.style.borderRadius = "0";
        }
      },
    });
    return new Promise((resolve) => canvas.toBlob((b) => resolve(b), "image/png"));
  }

  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
  let turnstileWidget: number | undefined;
  let turnstilePromise: Promise<any> | undefined;
  function loadTurnstile() {
    if (!TURNSTILE_SITE_KEY) return Promise.resolve(null);
    if ((window as any).turnstile) return Promise.resolve((window as any).turnstile);
    if (turnstilePromise) return turnstilePromise;
    turnstilePromise = new Promise((resolve) => {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true; script.defer = true;
      script.onload = () => resolve((window as any).turnstile || null);
      script.onerror = () => resolve(null);
      document.head.appendChild(script);
    });
    return turnstilePromise;
  }
  async function getTurnstileToken(): Promise<string | undefined> {
    const api = await loadTurnstile();
    if (!api) return undefined;
    return new Promise((resolve) => {
      const done = (token?: string) => {
        if (turnstileWidget !== undefined) api.reset(turnstileWidget);
        resolve(token);
      };
      try {
        if (turnstileWidget === undefined) {
          turnstileWidget = api.render("#turnstile-container", {
            sitekey: TURNSTILE_SITE_KEY, size: "invisible",
            callback: (token: string) => done(token),
            "error-callback": () => done(), "expired-callback": () => done(),
          });
        }
        api.execute(turnstileWidget);
      } catch { done(); }
    });
  }
  async function notifyFlorEnviada() {
    const turnstileToken = await getTurnstileToken();
    window.dispatchEvent(new CustomEvent("flor-enviada", { detail: { flower: selectedFlower, turnstileToken } }));
  }

  shareBtn?.addEventListener("click", async () => {
    feedback.textContent = "Gerando cartão...";
    const blob = await renderCardToBlob();
    if (!blob) {
      feedback.textContent = "Erro ao gerar imagem.";
      return;
    }
    const file = new File([blob], "cartao-manda-flores.png", { type: "image/png" });

    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({
          title: "LÉO MANDOU FLORES",
          text: `Você recebeu uma flor! Veja no link: ${window.location.origin}/`,
          files: [file],
        });
        feedback.textContent = "Cartão compartilhado ✓";
        await notifyFlorEnviada();
      } catch {
        feedback.textContent = "";
      }
    } else {
      feedback.textContent = "Esse navegador não suporta compartilhar arquivos — usa o Baixar ou o Copiar imagem.";
    }
    setTimeout(() => (feedback.textContent = ""), 3000);
  });

  downloadBtn?.addEventListener("click", async () => {
    feedback.textContent = "Gerando cartão...";
    const blob = await renderCardToBlob();
    if (!blob) {
      feedback.textContent = "Erro ao gerar imagem.";
      return;
    }
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "cartao-manda-flores.png";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    feedback.textContent = "Imagem baixada ✓";
    await notifyFlorEnviada();
    setTimeout(() => (feedback.textContent = ""), 2500);
  });

  clipboardBtn?.addEventListener("click", async () => {
    feedback.textContent = "Gerando cartão...";
    const blob = await renderCardToBlob();
    if (!blob) {
      feedback.textContent = "Erro ao gerar imagem.";
      return;
    }
    try {
      // @ts-ignore — ClipboardItem pode não existir em todo navegador
      await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
      feedback.textContent = "Imagem copiada — já pode colar ✓";
    } catch {
      feedback.textContent = "Esse navegador não deixa copiar imagem — usa o Baixar.";
    }
    setTimeout(() => (feedback.textContent = ""), 3000);
  });
</script>

<style>
  .manda {
    padding: 6rem 0 8rem;
  }

  /* Título via imagem */
  .manda__title {
    margin-bottom: 3.5rem;
    line-height: 1;
  }

  .manda__title-img {
    width: min(80vw, 26rem);
    height: auto;
    /* mix-blend-mode: multiply torna o fundo branco do PNG transparente
       sobre o fundo rosa da seção */
    mix-blend-mode: multiply;
    user-select: none;
  }

  .manda__grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 860px) {
    .manda__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .manda__field {
    margin-bottom: 2rem;
  }

  .manda__label {
    font-family: var(--font-rotulo);
    color: var(--roxo);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .manda__input {
    width: 100%;
    padding: 1rem 1.1rem;
    font-family: var(--font-corpo);
    font-size: 1.05rem;
    color: var(--roxo);
    font-weight: 500;
    background: rgba(59, 13, 30, 0.1);
    border: 1px solid rgba(59, 13, 30, 0.35);
    transition: border-color 0.2s, background 0.2s;
  }

  .manda__input::placeholder {
    color: var(--roxo);
    opacity: 0.6;
  }

  .manda__input:focus-visible {
    outline: 2px solid var(--roxo);
  }

  .manda__flowers {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    --flower-columns-mobile: 4;
  }

  .flower-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 4.8rem;
    min-height: 2.8rem;
    padding: 0.65rem 0.9rem;
    border: 2px solid rgba(59, 13, 30, 0.3);
    border-radius: 8px;
    background: rgba(59, 13, 30, 0.1);
    color: var(--roxo);
    cursor: url('/cursor/flower-hover.cur'), url('/cursor/flower-hover.png') 12 12, pointer;
    transition: all 0.2s var(--ease-out);
  }

  .flower-btn:hover {
    background: rgba(59, 13, 30, 0.18);
    transform: translateY(-2px);
  }

  .flower-btn[aria-pressed="true"] {
    background: var(--roxo);
    border-color: var(--roxo);
    color: var(--cream);
    box-shadow: 0 4px 12px rgba(59, 13, 30, 0.25);
  }

  .flower-btn[aria-pressed="true"] .flower-btn__img {
    filter: brightness(0) invert(1);
  }

  .flower-btn__img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    display: block;
  }

  .flower-btn__name {
    font-family: var(--font-rotulo);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  @media (max-width: 859px) {
    .manda__flowers {
      display: grid;
      grid-template-columns: repeat(var(--flower-columns-mobile), minmax(0, 1fr));
      gap: 0.45rem;
    }

    .flower-btn {
      min-width: 0;
      width: 100%;
      padding: 0.5rem 0.2rem;
      gap: 0.25rem;
    }

    .flower-btn__img {
      width: 24px;
      height: 24px;
    }

    .flower-btn__name {
      font-size: clamp(0.62rem, 2.2vw, 0.75rem);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    /* Para seis flores, altere para 3 e a grade vira 3x2 sem mudar o markup. */
    /* .manda__flowers { --flower-columns-mobile: 3; } */
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .manda__textarea-wrap {
    position: relative;
  }

  .manda__textarea {
    width: 100%;
    resize: none;
    padding: 1.25rem;
    font-family: var(--font-corpo);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--roxo);
    font-weight: 500;
    background: rgba(59, 13, 30, 0.1);
    border: 1px solid rgba(59, 13, 30, 0.35);
    transition: border-color 0.2s, background 0.2s;
  }

  .manda__textarea::placeholder {
    color: var(--roxo);
    opacity: 0.6;
  }

  .manda__textarea:focus-visible {
    outline: 2px solid var(--roxo);
  }

  .manda__count {
    position: absolute;
    bottom: 0.75rem;
    right: 0.9rem;
    font-family: var(--font-rotulo);
    font-size: 0.75rem;
    color: rgba(59, 13, 30, 0.45);
  }

  .manda__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .manda__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    min-height: 3rem;
    font-weight: 700;
    transition: opacity 0.2s, background 0.2s, transform 0.15s;
  }

  .manda__btn--icon {
    width: 3.2rem;
    padding: 0.9rem;
    justify-content: center;
  }

  .manda__btn--icon svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }

  .manda__btn--solid {
    background: var(--roxo);
    color: var(--cream);
  }

  .manda__btn--outline {
    background: transparent;
    border: 1px solid var(--roxo);
    color: var(--roxo);
  }

  .manda__btn--outline:hover:not(:disabled) {
    background: rgba(59, 13, 30, 0.1);
  }

  .manda__btn--ghost {
    background: transparent;
    color: rgba(59, 13, 30, 0.65);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .manda__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .manda__feedback {
    margin-top: 0.9rem;
    color: var(--roxo);
    font-weight: 600;
    letter-spacing: 0.08em;
    min-height: 1.2em;
  }

  @media (max-width: 480px) {
    .manda__actions {
      gap: 0.5rem;
    }

    .manda__btn:not(.manda__btn--icon) {
      padding-left: 1.15rem;
      padding-right: 1.15rem;
    }
  }

  /* ── Cartão: mesmo rosa da seção + borda roxa arredondada ── */
  .card {
    position: relative;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--rosa);
    border: 2.5px solid var(--roxo);
    border-radius: 18px;
    max-width: 26rem;
    /* cresce conforme o conteúdo ao digitar */
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card__to {
    font-family: var(--font-card);
    font-size: 1.2rem;
    color: var(--roxo);
    margin-bottom: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .card__to span {
    font-weight: 800;
  }

  .card__quote-box {
    border: 2px solid var(--roxo);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    min-height: 5.5rem;
    /* sem max-height fixo: cresce com a mensagem */
    display: flex;
    align-items: flex-start;
    transition: min-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card__quote {
    font-family: var(--font-card);
    font-weight: 800;
    font-size: clamp(0.95rem, 2.8vw, 1.3rem);
    line-height: 1.3;
    color: var(--roxo);
    word-break: break-word;
    overflow-wrap: break-word;
    /* sem clamp: o texto cresce livremente */
  }

  .card__quote--empty {
    color: var(--roxo);
    opacity: 0.45;
    font-weight: 500;
  }

  .card__footer {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    margin-top: 1.25rem;
  }

  .card__flower-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    min-width: 0;
    padding: 0 0.5rem;
    user-select: none;
    min-height: 3.35rem;
    justify-self: center;
  }

  .card__flower-icon {
    width: auto;
    height: auto;
    max-width: 41px;
    max-height: 41px;
    object-fit: contain;
    display: block;
    margin: 0 auto 2px;
  }

  .card__flower-name {
    font-family: var(--font-card);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.08em;
    color: rgba(59, 13, 30, 0.65);
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    max-width: 100%;
  }

  .card__qr-wrap {
    /* Remove qualquer borda/fundo branco do QR code */
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 4px;
    overflow: hidden;
    background: transparent;
    line-height: 0;
    justify-self: start;
  }

  .card__qr {
    display: block;
    width: 56px;
    height: 56px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border: none;
    background: transparent;
  }

  .card__logo {
    height: 79px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    justify-self: end;
    transform: translateY(10px);
  }
</style>
