---
// ─────────────────────────────────────────────────────────────
// BUQUÊ — seção 3 da landing.
//
// • O número exibido é o contador REAL (GET/POST em /api/bouquet).
// • Cada vez que alguém envia um cartão em "Envie uma Flor", o evento
//   "flor-enviada" (disparado em MandaFlores.astro) soma +1 e uma flor
//   voa até o buquê, alternando o lado de saída (esquerda, direita...).
// • As flores desenhadas têm LIMITE (MAX_FLOWERS = 75). Passando disso o
//   contador continua subindo, mas o buquê fica cheio e estático.
//
// ONDE TROCAR POR ARTE FINAL:
//   - Vaso:   const VASE    → preencher `src` (ex.: "/vaso.png") e ajustar a caixa
//   - Flores: const FLOWERS → preencher `src` de cada uma (ex.: "/flores/flor-01.png")
// ─────────────────────────────────────────────────────────────
---

<section id="buque" class="bouquet panel panel--roxo">
  <div class="wrap bouquet__inner">
    <h2 class="bouquet__title reveal">BUQUÊ</h2>
    <p class="eyebrow bouquet__count reveal" data-delay="0.05" aria-live="polite">
      <span id="bouquet-count">—</span> <span id="bouquet-count-label">flores enviadas</span>
    </p>

    <!-- O <svg> do buquê é criado pelo script abaixo -->
    <div id="bouquet-stage" class="bouquet__stage reveal" data-delay="0.1" role="img" aria-label="Buquê de flores que cresce a cada cartão enviado"></div>
  </div>
</section>

<script>
  const NS = "http://www.w3.org/2000/svg";

  /* ───────────── 1. CONFIGURAÇÃO ───────────── */

  const MAX_FLOWERS = 75;     // limite de flores desenhadas (o contador NÃO tem limite)
  const LAYOUT_N = 100;       // "tamanho de referência" do desenho do domo — NÃO mexer: é isso que mantém o buquê
                              // com 75 flores exatamente como foi aprovado (redondo, sem vazios)
  const MAX_FLYERS = 4;       // se chegarem várias de uma vez (polling), só N voam; o resto aparece direto
  const POLL_MS = 15000;      // de quanto em quanto tempo relê o contador (0 = desliga)
  const STROKE = "#3b0d1e";   // contorno das flores (igual ao fundo da seção: --roxo)
  const STEM = "#8f0a3d";     // cor dos caules

  /* Vaso. Hoje é um trapézio PLACEHOLDER.
     Para usar o seu vaso: coloque o PNG/SVG em /public, preencha `src` e ajuste a caixa (x, y, w, h)
     — coordenadas do SVG (viewBox 600 x 600).
     • A imagem é encaixada na caixa mantendo a proporção, com o TOPO alinhado ao topo da caixa.
     • A BOCA do vaso fica no topo da caixa e centralizada em x + w/2: é daí que saem os caules.
     • O corpo do vaso precisa ser OPACO (os caules nascem "dentro" dele e ficam escondidos atrás). */
  const VASE: { src: string | null; x: number; y: number; w: number; h: number } = {
    src: null,                // ex.: "/vaso.png"
    x: 190, y: 470, w: 220, h: 230,
  };

  /* Flores. Cada item é um tipo; as flores sorteiam entre eles (de forma fixa por posição).
     • src: null → flor placeholder em SVG (usa `petal` e `center`)
     • src: "/flores/flor-01.png" → seu PNG/SVG: quadrado, fundo transparente, flor centralizada, ~256 px
     Para ter mais variações é só adicionar itens ao array. */
  const FLOWERS: { src: string | null; petal: string; center: string }[] = [
    { src: null, petal: "#ff2e7e", center: "#ffe3ee" },
    { src: null, petal: "#ca0053", center: "#ffd1e0" },
    { src: null, petal: "#ff7ab0", center: "#7a0030" },
    { src: null, petal: "#ffc2da", center: "#ca0053" },
    { src: null, petal: "#e8175d", center: "#ffffff" },
  ];

  /* ───────────── 2. ELEMENTOS ───────────── */

  const root = document.getElementById("buque");
  const stage = document.getElementById("bouquet-stage");
  const countEl = document.getElementById("bouquet-count");
  const labelEl = document.getElementById("bouquet-count-label");
  if (!root || !stage || !countEl || !labelEl) throw new Error("[bouquet] elementos da seção não encontrados");

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const el = (name: string, attrs: Record<string, string | number> = {}) => {
    const n = document.createElementNS(NS, name);
    for (const k in attrs) n.setAttribute(k, String(attrs[k]));
    return n;
  };

  /* ───────────── 3. SVG (camadas: caules → vaso → flores → trilha → flor em voo) ───────────── */

  const VB = { x: 0, y: 120, w: 600, h: 600 };
  const CX = VASE.x + VASE.w / 2;   // centro da boca do vaso
  const MOUTH_Y = VASE.y;           // altura da boca do vaso

  const svg = el("svg", { viewBox: `${VB.x} ${VB.y} ${VB.w} ${VB.h}`, class: "bouquet__svg", "aria-hidden": "true" });
  const stemsLayer = el("g");
  const flowersLayer = el("g");
  const trailLayer = el("g");
  const flyLayer = el("g");

  let vase: Element;
  if (VASE.src) {
    vase = el("image", { href: VASE.src, x: VASE.x, y: VASE.y, width: VASE.w, height: VASE.h, preserveAspectRatio: "xMidYMin meet" });
  } else {
    const inset = VASE.w * 0.27;
    const r = VASE.x + VASE.w;
    const b = VASE.y + VASE.h;
    vase = el("polygon", {
      points: `${VASE.x},${VASE.y} ${r},${VASE.y} ${r - inset},${b} ${VASE.x + inset},${b}`,
      fill: "var(--rosa)",
      stroke: "var(--rosa-soft)",
      "stroke-width": 2,
      "stroke-linejoin": "round",
    });
  }
  svg.append(stemsLayer, vase, flowersLayer, trailLayer, flyLayer);
  stage.appendChild(svg);

  /* ───────────── 4. POSIÇÃO DE CADA FLOR ─────────────
     Espiral de girassol dentro de uma elipse (domo redondo e cheio). O raio cresce com sqrt(i), então
     as flores já colocadas nunca mudam de lugar quando entram novas. Posições determinísticas:
     recarregar a página mostra sempre o mesmo buquê. */

  function rng(seed: number) {      // mulberry32
    let a = seed >>> 0;
    return () => {
      a += 0x6d2b79f5;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const DOME = { rx: 235, ry: 158, cy: MOUTH_Y - 138 };   // tamanho do domo e centro (acima da boca do vaso)
  const GOLDEN = Math.PI * (3 - Math.sqrt(5));

  function slot(i: number) {
    const r = rng(i * 9973 + 17);
    const k = Math.sqrt((i + 0.5) / LAYOUT_N);
    const th = i * GOLDEN;
    return {
      x: CX + Math.cos(th) * DOME.rx * k + (r() - 0.5) * 14,
      y: DOME.cy + Math.sin(th) * DOME.ry * k + (r() - 0.5) * 12,
      rot: r() * 360,
      size: 40 + r() * 14,
      variant: Math.floor(r() * FLOWERS.length),
    };
  }

  /* ───────────── 5. DESENHO DA FLOR ───────────── */

  function makeFlower(variant: number, size: number) {
    const f = FLOWERS[variant % FLOWERS.length];
    const outer = el("g");
    const pop = el("g");
    const sc = el("g", { transform: `scale(${size / 100})` });
    if (f.src) {
      sc.appendChild(el("image", { href: f.src, x: -50, y: -50, width: 100, height: 100 }));
    } else {
      for (let k = 0; k < 5; k++) {
        sc.appendChild(
          el("ellipse", { cx: 0, cy: -24, rx: 17, ry: 28, fill: f.petal, stroke: STROKE, "stroke-width": 2.5, transform: `rotate(${k * 72})` })
        );
      }
      sc.appendChild(el("circle", { r: 12, fill: f.center, stroke: STROKE, "stroke-width": 2 }));
    }
    pop.appendChild(sc);
    outer.appendChild(pop);
    return { outer, pop, color: f.petal };
  }

  /* ───────────── 6. COLOCAR UMA FLOR NO BUQUÊ ───────────── */

  function place(i: number, animate: boolean) {
    if (i >= MAX_FLOWERS) return;                  // buquê cheio: nada mais é desenhado
    const s = slot(i);

    const stem = el("path", {
      class: "bq-stem" + (animate && !reduced ? " bq-grow" : ""),
      pathLength: 1,
      d: `M ${CX + (s.x - CX) * 0.12} ${MOUTH_Y + 30} Q ${CX + (s.x - CX) * 0.5} ${MOUTH_Y - (MOUTH_Y - s.y) * 0.45} ${s.x} ${s.y}`,
    });
    stemsLayer.appendChild(stem);

    const fl = makeFlower(s.variant, s.size);
    fl.outer.setAttribute("transform", `translate(${s.x} ${s.y}) rotate(${s.rot})`);
    if (animate && !reduced) fl.pop.setAttribute("class", "bq-pop");
    flowersLayer.appendChild(fl.outer);
  }

  /* ───────────── 7. FLOR VOANDO DA PONTA DA SEÇÃO (alterna esquerda / direita) ───────────── */

  let nextSide = -1;                               // -1 = esquerda, +1 = direita, alternando a cada flor

  function startPoint(side: number) {
    const m = svg.getScreenCTM();
    if (!m) return { x: side < 0 ? VB.x - 60 : VB.x + VB.w + 60, y: VB.y };
    const r = root!.getBoundingClientRect();
    const sx = side < 0 ? r.left + 10 : r.right - 10;
    return new DOMPoint(sx, Math.max(r.top, 0) + 10).matrixTransform(m.inverse());
  }

  function flyTo(i: number) {
    if (i >= MAX_FLOWERS) return;
    if (reduced) {
      place(i, false);
      return;
    }
    const s = slot(i);
    const side = nextSide;
    nextSide = -nextSide;

    const p0 = startPoint(side);
    const p1 = { x: p0.x + (s.x - p0.x) * 0.6, y: p0.y + (s.y - p0.y) * 0.15 };
    const fl = makeFlower(s.variant, s.size);
    flyLayer.appendChild(fl.outer);

    const dur = 1100;
    const t0 = performance.now();
    let frame = 0;

    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2; // easeInOutCubic
      const u = 1 - e;
      const x = u * u * p0.x + 2 * u * e * p1.x + e * e * s.x;
      const y = u * u * p0.y + 2 * u * e * p1.y + e * e * s.y;
      fl.outer.setAttribute("transform", `translate(${x} ${y}) rotate(${s.rot + side * 360 * e}) scale(${0.6 + 0.4 * e})`);

      if (frame++ % 2 === 0 && k < 1) {            // trilha de partículas
        const dot = el("circle", { cx: x, cy: y, r: 1.5 + Math.random() * 2.5, fill: fl.color, opacity: 0.7 });
        trailLayer.appendChild(dot);
        const anim = dot.animate([{ opacity: 0.7 }, { opacity: 0 }], { duration: 800, fill: "forwards" });
        anim.onfinish = () => dot.remove();
      }

      if (k < 1) requestAnimationFrame(step);
      else {
        fl.outer.remove();
        place(i, true);
      }
    };
    requestAnimationFrame(step);
  }

  /* ───────────── 8. CONTADOR NA TELA ───────────── */

  const fmt = (n: number) => n.toLocaleString("pt-BR");
  let shownNumber = 0;

  function renderNumber(n: number) {
    countEl!.textContent = fmt(n);
    labelEl!.textContent = n === 1 ? "flor enviada" : "flores enviadas";
  }

  function animateNumber(to: number) {
    const from = shownNumber;
    const t0 = performance.now();
    const dur = reduced ? 0 : 600;
    const tick = (now: number) => {
      const k = dur ? Math.min(1, (now - t0) / dur) : 1;
      renderNumber(Math.round(from + (to - from) * k));
      if (k < 1) requestAnimationFrame(tick);
      else shownNumber = to;
    };
    requestAnimationFrame(tick);
  }

  /* ───────────── 9. SINCRONIZAR COM O TOTAL ───────────── */

  let total = 0;        // maior total já conhecido (o contador sempre sobe)

  function reveal(newTotal: number) {
    if (newTotal <= total) return;

    const drawnBefore = Math.min(total, MAX_FLOWERS);
    const drawnAfter = Math.min(newTotal, MAX_FLOWERS);
    const toDraw = drawnAfter - drawnBefore;       // 0 quando o buquê já está cheio
    total = newTotal;
    animateNumber(newTotal);

    const flying = Math.min(toDraw, MAX_FLYERS);
    const instant = toDraw - flying;
    for (let j = 0; j < instant; j++) place(drawnBefore + j, false);
    for (let j = 0; j < flying; j++) {
      const idx = drawnBefore + instant + j;
      setTimeout(() => flyTo(idx), j * 260);
    }
  }

  interface BouquetData {
    count?: number;
    persisted?: boolean;
    error?: boolean;
    limited?: boolean;
  }

  let hasConfirmedCount = false;

  async function fetchBouquet(method = "GET"): Promise<BouquetData | null> {
    try {
      const res = await fetch("/api/bouquet", { method });
      if (!res.ok) {
        console.error(`[bouquet] Resposta inesperada do servidor (${res.status})`);
        return null;
      }
      return await res.json();
    } catch (e) {
      console.error("[bouquet] Falha na comunicação:", (e as Error)?.message || "erro de rede");
      return null;
    }
  }

  async function sendFlower() {
    const isProd = import.meta.env.PROD;

    // Em desenvolvimento local: pode simular se a API não estiver conectada
    if (!isProd) {
      try {
        const data = await fetchBouquet("POST");
        if (data && Number.isFinite(Number(data.count))) {
          reveal(Number(data.count));
        } else {
          reveal(total + 1);
        }
      } catch {
        reveal(total + 1);
      }
      return;
    }

    // Em produção: só anima e soma se o servidor confirmar a gravação de verdade
    const data = await fetchBouquet("POST");
    if (!data || data.error || data.persisted === false) {
      return;
    }

    const n = Number(data.count);
    if (Number.isFinite(n)) {
      reveal(n);
    }
  }

  async function poll() {
    if (document.hidden) return;
    const data = await fetchBouquet("GET");
    if (!data) return;
    const isProd = import.meta.env.PROD;
    if (isProd && (data.persisted === false || data.error)) return;

    const n = Number(data.count);
    if (Number.isFinite(n)) {
      hasConfirmedCount = true;
      reveal(n);
    }
  }

  async function init() {
    const data = await fetchBouquet("GET");
    const isProd = import.meta.env.PROD;

    if (data && (!isProd || data.persisted)) {
      const n = Number(data.count) || 0;
      hasConfirmedCount = true;
      const initial = Math.min(n, MAX_FLOWERS);
      for (let i = 0; i < initial; i++) place(i, false);   // buquê "pronto", sem animação
      total = n;
      shownNumber = n;
      renderNumber(n);
    } else if (!isProd) {
      hasConfirmedCount = true;
      renderNumber(0);
    } else {
      // Em produção se a API falhar ou não persistir: mantém o último valor conhecido ou "—"
      if (!hasConfirmedCount) {
        countEl!.textContent = "—";
      }
    }

    if (POLL_MS > 0) setInterval(poll, POLL_MS);
  }

  // Alguém enviou um cartão de verdade (disparado em MandaFlores.astro)
  window.addEventListener("flor-enviada", sendFlower);

  init();
</script>

<style>
  .bouquet {
    padding: 7rem 0 8rem;
    text-align: center;
    overflow: hidden; /* as flores entram voando pelas pontas da seção */
  }

  .bouquet__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bouquet__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.8rem, 9vw, 5rem);
    letter-spacing: 0.05em;
    color: var(--rosa);
    margin-bottom: 0.6rem;
  }

  .bouquet__count {
    color: rgba(246, 233, 222, 0.5);
    margin-bottom: 2rem;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
  }

  .bouquet__count #bouquet-count {
    color: var(--rosa);
    font-weight: 800;
    font-size: 1.1rem;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }

  .bouquet__stage {
    width: min(94vw, 36rem);
  }

  /* O <svg> e o que vai dentro são criados pelo script, por isso :global */
  .bouquet__stage :global(.bouquet__svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>

<!-- Classes criadas pelo script (caule/pop das flores) + @keyframes: precisam ser globais -->
<style is:global>
  .bq-stem {
    stroke: #8f0a3d;
    stroke-width: 2.5;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .bq-grow {
    animation: bq-grow 0.7s ease-out both;
  }

  .bq-pop {
    transform-origin: 0 0;
    animation: bq-pop 0.55s cubic-bezier(0.2, 1.6, 0.4, 1) both;
  }

  @keyframes bq-grow {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes bq-pop {
    from { transform: scale(0.3); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bq-grow,
    .bq-pop {
      animation: none;
    }
  }
</style>
