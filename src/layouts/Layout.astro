---
import "../styles/global.css";
import { SITE } from "../data/site.js";

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? "LÉO MANDOU FLORES | Ouça agora";
const description = Astro.props.description ?? "Léo Mandou Flores é um álbum para ouvir agora, enviar flores e compartilhar mensagens. Ouça no Spotify, Apple Music, YouTube e SoundCloud.";
const canonical = new URL(Astro.url.pathname, "https://leomandouflores.com").toString();
const isPreview = Boolean(import.meta.env.VERCEL_ENV && import.meta.env.VERCEL_ENV !== "production");
const artist = "Leon Andrade";
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: "Léo Mandou Flores", alternateName: "Leo Mandou Flores", url: "https://leomandouflores.com/" },
    {
      "@type": "MusicAlbum",
      name: "Léo Mandou Flores",
      byArtist: { "@type": "Person", name: artist },
      image: "https://leomandouflores.com/og-cover.jpg",
      url: "https://leomandouflores.com/",
      sameAs: SITE.streaming.filter((stream) => stream.href !== "#").map((stream) => stream.href),
    },
    { "@type": "Person", name: artist, sameAs: [SITE.instagramUrl, ...SITE.streaming.filter((stream) => stream.href !== "#").map((stream) => stream.href)] },
  ],
};
---

<html lang="pt-BR">
  <head>
    <style is:inline>
      html, body { background: #ca0053; }
      html[data-theme="escuro"], html[data-theme="escuro"] body { background: #3b0d1e; }
      #site-loader { position: fixed; inset: 0; z-index: 200; display: none; place-items: center; background: #ca0053; opacity: 1; transition: opacity .3s ease; }
      html.loader-first #site-loader { display: grid; animation: loader-safety 4s ease forwards; }
      html[data-theme="escuro"] #site-loader { background: #3b0d1e; }
      #site-loader.is-hidden { opacity: 0; pointer-events: none; }
      html.loader-first #site-loader.is-hidden { animation: loader-fade .3s ease forwards; }
      #site-loader-flower { width: 56px; height: 56px; animation: loader-breathe 1.2s ease-in-out infinite; }
      @keyframes loader-breathe { 50% { transform: scale(1.12) rotate(8deg); } }
      @keyframes loader-safety { 0%, 92% { opacity: 1; pointer-events: auto; } 100% { opacity: 0; pointer-events: none; } }
      @keyframes loader-fade { from { opacity: 1; } to { opacity: 0; } }
      html[data-theme="escuro"] #site-loader-flower { filter: brightness(0) saturate(100%) invert(91%) sepia(13%) saturate(240%) hue-rotate(324deg) brightness(104%); }
      @media (prefers-reduced-motion: reduce) { #site-loader-flower { animation: none; } #site-loader { transition: none; } }
    </style>
    <script is:inline>
      (() => { try { if (localStorage.getItem("leo-theme") === "escuro") document.documentElement.dataset.theme = "escuro"; } catch {} })();
    </script>
    <script is:inline>
      (() => {
        let first = true;
        try {
          first = !sessionStorage.getItem("leo-loader-seen");
          if (first) sessionStorage.setItem("leo-loader-seen", "1");
        } catch {}
        if (first) document.documentElement.classList.add("loader-first");
      })();
    </script>
    <script is:inline>history.scrollRestoration = "manual"; window.scrollTo(0, 0);</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ca0053" id="theme-color" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href="/generated/hero-logo-480.avif" imagesrcset="/generated/hero-logo-480.avif 480w, /generated/hero-logo-768.avif 768w, /generated/hero-logo-1024.avif 1024w, /generated/hero-logo-1536.avif 1536w" imagesizes="(max-width: 520px) 88vw, min(88vw, 672px)" type="image/avif" fetchpriority="high" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://leomandouflores.com/og-cover.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Capa do álbum Léo Mandou Flores" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="music.album" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Léo Mandou Flores" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://leomandouflores.com/og-cover.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
  </head>
  <body>
    <style is:inline>
      #site-loader { position: fixed; inset: 0; z-index: 200; display: none; place-items: center; }
      html.loader-first #site-loader { display: grid; }
    </style>
    <div id="site-loader" aria-hidden="true"><img id="site-loader-flower" src="/cursor/flower.png" alt="" width="56" height="56" /></div>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="grain" aria-hidden="true"></div>
    <slot />

    <footer class="site-footer">
      <p>Léo Mandou Flores · <button type="button" id="privacy-open" class="privacy-link">privacidade</button></p>
    </footer>
    <div id="privacy-modal" class="privacy-modal" role="dialog" aria-modal="true" aria-labelledby="privacy-title" hidden>
      <div class="privacy-modal__panel" role="document">
        <button type="button" id="privacy-close" class="privacy-modal__close" aria-label="Fechar privacidade">×</button>
        <h2 id="privacy-title">Privacidade</h2>
        <p>Este site não coleta dados pessoais. O nome e a mensagem do cartão ficam só no seu navegador e não são enviados a um servidor.</p>
        <p>O contador guarda apenas um número total. O IP é usado temporariamente só para limitar abuso.</p>
        <p>Usamos o Cloudflare Turnstile contra bots. Saiba mais na <a href="https://www.cloudflare.com/turnstile-privacy-policy/" target="_blank" rel="noopener">política de privacidade do Turnstile</a> e na <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">política de privacidade da Cloudflare</a>.</p>
      </div>
    </div>

    <script>
      import { initPetalCursor } from "../scripts/petal-cursor";
      import { initReveals } from "../scripts/reveals";
      initPetalCursor();
      initReveals();

      const modal = document.getElementById("privacy-modal") as HTMLDivElement;
      const open = document.getElementById("privacy-open") as HTMLButtonElement;
      const close = document.getElementById("privacy-close") as HTMLButtonElement;
      let previous: HTMLElement | null = null;
      function setModal(value: boolean) {
        modal.hidden = !value;
        document.body.classList.toggle("modal-open", value);
        if (value) { previous = document.activeElement as HTMLElement; close.focus(); }
        else previous?.focus();
      }
      const loader = document.getElementById("site-loader");
      if (document.documentElement.classList.contains("loader-first") && loader) {
        const startedAt = performance.now();
        const waitForWindow = document.readyState === "complete"
          ? Promise.resolve()
          : new Promise<void>((resolve) => window.addEventListener("load", () => resolve(), { once: true }));
        const waitForFonts = document.fonts?.ready ?? Promise.resolve();
        const hero = document.querySelector<HTMLImageElement>(".hero__logo");
        const waitForHero = hero?.decode ? hero.decode().catch(() => undefined) : Promise.resolve();
        const finish = () => {
          const remaining = Math.max(0, 1000 - (performance.now() - startedAt));
          window.setTimeout(() => loader.classList.add("is-hidden"), remaining);
        };
        Promise.all([waitForWindow, waitForFonts, waitForHero]).then(finish, finish);
        window.setTimeout(() => loader.classList.add("is-hidden"), 3800);
      }
      open.addEventListener("click", () => setModal(true));
      close.addEventListener("click", () => setModal(false));
      modal.addEventListener("click", (event) => { if (event.target === modal) setModal(false); });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.hidden) setModal(false);
        if (event.key === "Tab" && !modal.hidden) {
          const focusable = Array.from(modal.querySelectorAll<HTMLElement>("button, a[href]"));
          if (focusable.length === 0) return;
          const first = focusable[0], last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });
    </script>
  </body>
</html>

<style>
  .site-footer { background: var(--panel-alt); border-top: 0; color: rgba(246, 233, 222, 0.72); text-align: center; padding: 1.5rem; font: 600 var(--fs-xs) var(--font-main); letter-spacing: .06em; text-transform: uppercase; }
  .privacy-link { color: inherit; background: none; border: 0; padding: .2rem; text-decoration: underline; font: inherit; }
  .privacy-modal { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 1.2rem; background: rgba(59,13,30,.7); }
  .privacy-modal[hidden] { display: none; }
  .privacy-modal__panel { position: relative; max-width: 34rem; padding: 2rem; color: var(--roxo); background: var(--cream); border: 2px solid var(--roxo); }
  .privacy-modal__panel h2 { margin-top: 0; font: 800 2rem var(--font-titulo); }
  .privacy-modal__panel p { max-width: 34rem; font-family: var(--font-text); line-height: 1.5; }
  .privacy-modal__panel a { color: var(--rosa-deep); }
  .privacy-modal__close { position: absolute; top: .4rem; right: .7rem; border: 0; background: none; color: inherit; font-size: 1.8rem; }
  :global(html[data-theme="escuro"]) .privacy-modal__panel { color: var(--cream); background: var(--roxo-soft); border-color: var(--cream); }
  :global(html[data-theme="escuro"]) .privacy-modal__panel a { color: var(--cream); }
  .modal-open { overflow: hidden; }
</style>
