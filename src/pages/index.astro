---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import MandaFlores from "../components/MandaFlores.astro";
import Bouquet from "../components/Bouquet.astro";
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <section class="album-description panel panel--rosa" aria-label="Sobre o álbum">
      <p>Léo Mandou Flores é um álbum de Leon Andrade. Ouça agora no <a href="https://open.spotify.com/intl-pt/artist/0H1Vd2f6hQTru3k1nHl6O2?si=Tk6IjQ61SOK2Mzvdiwjz0w" target="_blank" rel="noopener">Spotify</a>, <a href="https://music.apple.com/us/song/i-remain-the-same/1729937841" target="_blank" rel="noopener">Apple Music</a>, <a href="https://www.youtube.com/@leonandradej/videos" target="_blank" rel="noopener">YouTube</a> ou <a href="https://soundcloud.com/leonandradej/tracks" target="_blank" rel="noopener">SoundCloud</a>.</p>
    </section>
    <MandaFlores />
    <Bouquet />
  </main>
</Layout>
